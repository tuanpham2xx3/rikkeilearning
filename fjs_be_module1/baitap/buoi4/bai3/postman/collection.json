{
  "info": {
    "name": "Products API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Lấy danh sách sản phẩm",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": ["{{base_url}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response đúng cấu trúc đã thiết kế\", () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('success', true);",
              "  pm.expect(json.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Xem chi tiết sản phẩm #1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/1",
          "host": ["{{base_url}}"],
          "path": ["api", "products", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response đúng cấu trúc đã thiết kế\", () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('success', true);",
              "  pm.expect(json.data).to.have.property('id', 1);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Xem chi tiết sản phẩm #2",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/2",
          "host": ["{{base_url}}"],
          "path": ["api", "products", "2"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response đúng cấu trúc đã thiết kế\", () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('success', true);",
              "  pm.expect(json.data.name).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Tạo sản phẩm mới",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Asus ROG Zephyrus G14\",\n  \"price\": 49990000\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": ["{{base_url}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 201\", () => {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response đúng cấu trúc đã thiết kế\", () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('success', true);",
              "  pm.expect(json.data).to.have.property('id');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Bắt lỗi không tìm thấy sản phẩm (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/999",
          "host": ["{{base_url}}"],
          "path": ["api", "products", "999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 404\", () => {",
              "  pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Response đúng cấu trúc đã thiết kế\", () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('success', false);",
              "  pm.expect(json.code).to.equal('PRODUCT_NOT_FOUND');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
