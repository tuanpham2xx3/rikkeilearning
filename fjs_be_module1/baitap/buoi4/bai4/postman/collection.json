{
  "info": {
    "name": "Products API Automated Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET /api/products (Danh sách)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": ["{{base_url}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Data là array\", () => pm.expect(pm.response.json().data).to.be.an('array'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. GET /api/products/1 (Chi tiết)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/1",
          "host": ["{{base_url}}"],
          "path": ["api", "products", "1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Đúng ID 1\", () => pm.expect(pm.response.json().data.id).to.equal(1));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. POST /api/products (Tạo thành công)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"iPad Pro M4\", \"price\": 28900000}"
        },
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": ["{{base_url}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Có id trả về\", () => pm.expect(pm.response.json().data).to.have.property('id'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. GET /api/products/999 (404 Not Found)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/999",
          "host": ["{{base_url}}"],
          "path": ["api", "products", "999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"Code là PRODUCT_NOT_FOUND\", () => pm.expect(pm.response.json().code).to.equal('PRODUCT_NOT_FOUND'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. Edge case 1: POST Body rỗng (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": ["{{base_url}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Code là MISSING_FIELDS\", () => pm.expect(pm.response.json().code).to.equal('MISSING_FIELDS'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Edge case 2: POST price không hợp lệ (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Loa Bluetooth\", \"price\": -50000}"
        },
        "url": {
          "raw": "{{base_url}}/api/products",
          "host": ["{{base_url}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Code là INVALID_PRICE_FORMAT\", () => pm.expect(pm.response.json().code).to.equal('INVALID_PRICE_FORMAT'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. Edge case 3: Limit vượt giới hạn 50 (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products?limit=100",
          "host": ["{{base_url}}"],
          "path": ["api", "products"],
          "query": [{ "key": "limit", "value": "100" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Code là INVALID_LIMIT\", () => pm.expect(pm.response.json().code).to.equal('INVALID_LIMIT'));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. GET có query limit hợp lệ",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products?limit=2",
          "host": ["{{base_url}}"],
          "path": ["api", "products"],
          "query": [{ "key": "limit", "value": "2" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code là 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Số lượng trả về đúng limit\", () => pm.expect(pm.response.json().data.length).to.equal(2));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
